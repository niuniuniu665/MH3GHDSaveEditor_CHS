<Application
    x:Class="MH3GHDSaveEditor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MH3GHDSaveEditor"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme
                    BaseTheme="Inherit"
                    PrimaryColor="#FF00688B"
                    SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#F5F5F5" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
