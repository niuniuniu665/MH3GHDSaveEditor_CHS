<Page
    x:Class="MH3GHDSaveEditor.Pages.EquipEdit.EquipEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:MH3GHDSaveEditor.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MH3GHDSaveEditor.Pages.EquipEdit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EquipEditPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="EquipEditPage_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <cv:IntValueConverter x:Key="IntValueConverter" />
        <cv:EquipTypeUIntConverter x:Key="EquipTypeUIntConverter" />
    </Page.Resources>
    <Grid>
        <GroupBox Header="装备箱">
            <Grid>
                <DataGrid
                    x:Name="EquipDataGrid"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                    VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">

                            <!--  普通行  -->
                            <Setter Property="Background" Value="{DynamicResource DataGridRowBackgroundBrush}" />

                            <Style.Triggers>
                                <!--  交替行  -->
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource DataGridAlternatingRowBackgroundBrush}" />
                                </Trigger>

                                <!--  悬停：写在交替行 Trigger 之后，就会覆盖它  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#22000000" />
                                </Trigger>

                                <!--  选中：优先级最高  -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#44000000" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding ListRow}"
                            CanUserSort="False"
                            Header="#"
                            IsReadOnly="True" />

                        <DataGridTemplateColumn Header="装备类型">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding EquipTypeIdName.Name}"
                                        ToolTip="双击编辑" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <!--  编辑模式  -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Name"
                                        IsEditable="False"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding DataContext.EquipTypeList, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding EquipType, Mode=TwoWay, Converter={StaticResource EquipTypeUIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        StaysOpenOnEdit="True"
                                        TextSearch.TextPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="选择装备">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding EquipIdName.Name}"
                                        ToolTip="双击编辑" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <!--  编辑模式  -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Name"
                                        IsEditable="True"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding EquipNameList}"
                                        SelectedValue="{Binding EquipID, Mode=TwoWay, Converter={StaticResource IntValueConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        StaysOpenOnEdit="True"
                                        TextSearch.TextPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="防具强化次数/护石孔位">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding LevelorSlotsIsEnabled}"
                                        Text="{Binding LevelorSlots, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="护石技能1">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding SkillIsEnabled}"
                                        Text="{Binding Skill_1Name.Name}"
                                        ToolTip="双击编辑" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <!--  编辑模式  -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Name"
                                        IsEditable="True"
                                        IsEnabled="{Binding SkillIsEnabled}"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding DataContext.SkillList, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding Skill_1, Mode=TwoWay, Converter={StaticResource EquipTypeUIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        StaysOpenOnEdit="True"
                                        TextSearch.TextPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="护石技能1值">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding SkillIsEnabled}"
                                        Text="{Binding Skill_1Point, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="护石技能2">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding SkillIsEnabled}"
                                        Text="{Binding Skill_2Name.Name}"
                                        ToolTip="双击编辑" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <!--  编辑模式  -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Name"
                                        IsEditable="True"
                                        IsEnabled="{Binding SkillIsEnabled}"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding DataContext.SkillList, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding Skill_2, Mode=TwoWay, Converter={StaticResource EquipTypeUIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        StaysOpenOnEdit="True"
                                        TextSearch.TextPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="护石技能2值">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding SkillIsEnabled}"
                                        Text="{Binding Skill_2Point, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Page>
