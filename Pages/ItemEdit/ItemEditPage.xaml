<Page
    x:Class="MH3GHDSaveEditor.Pages.ItemEdit.ItemEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:MH3GHDSaveEditor.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MH3GHDSaveEditor.Pages.ItemEdit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="clr-namespace:MH3GHDSaveEditor"
    xmlns:sd="clr-namespace:MH3GHDSaveEditor.SaveDataModel"
    Title="ItemEditPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="ItemEditPage_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <cv:IntValueConverter x:Key="IntValueConverter" />
    </Page.Resources>
    <Grid>
        <GroupBox Header="道具箱">
            <Grid>
                <DataGrid
                    x:Name="ItemDataGrid"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                    VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">

                            <!--  普通行  -->
                            <Setter Property="Background" Value="{DynamicResource DataGridRowBackgroundBrush}" />

                            <Style.Triggers>
                                <!--  交替行  -->
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource DataGridAlternatingRowBackgroundBrush}" />
                                </Trigger>

                                <!--  悬停：写在交替行 Trigger 之后，就会覆盖它  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#22000000" />
                                </Trigger>

                                <!--  选中：优先级最高  -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#44000000" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding ListRow}"
                            CanUserSort="False"
                            Header="#"
                            IsReadOnly="True" />
                        <!--  道具ID列（ComboBox选择）  -->
                        <DataGridTemplateColumn Width="300" Header="道具">
                            <!--  显示模式  -->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding IdName.Name}"
                                        ToolTip="双击编辑">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Id}" Value="0">
                                                        <Setter Property="Text" Value="(空)" />
                                                        <Setter Property="Foreground" Value="Gray" />
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <!--  编辑模式  -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Name"
                                        IsEditable="True"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding DataContext.ItemList, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding Id, Mode=TwoWay, Converter={StaticResource IntValueConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        StaysOpenOnEdit="True"
                                        TextSearch.TextPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="数量">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox VerticalAlignment="Center" Text="{Binding Count}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Page>
