<Page
    x:Class="MH3GHDSaveEditor.Pages.EquipSetEdit.EquipSetEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MH3GHDSaveEditor.Pages.EquipSetEdit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="EquipSetEditRoot"
    Title="EquipSetEditPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="EquipSetEditPage_Loaded"
    mc:Ignorable="d">

    <Grid>
        <!--  直接放在任意 Grid 或 GroupBox 中  -->
        <GroupBox Margin="10" Header="套装列表">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <DataGrid
                    x:Name="EquipSetNameDataGrid"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                    SelectionChanged="EquipSetNameDataGrid_SelectionChanged"
                    VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">

                            <!--  普通行  -->
                            <Setter Property="Background" Value="{DynamicResource DataGridRowBackgroundBrush}" />

                            <Style.Triggers>
                                <!--  交替行  -->
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource DataGridAlternatingRowBackgroundBrush}" />
                                </Trigger>

                                <!--  悬停：写在交替行 Trigger 之后，就会覆盖它  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#22000000" />
                                </Trigger>

                                <!--  选中：优先级最高  -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#44000000" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" Header="套装名称">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding EquipSetName}"
                                        ToolTip="双击编辑" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox VerticalAlignment="Center" Text="{Binding EquipSetName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>
                <Grid Grid.Column="1">
                    <DataGrid
                        x:Name="EquipSlotsDataGrid"
                        AlternationCount="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="All"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                        ItemsSource="{Binding ElementName=EquipSetEditRoot, Path=equipSetSlotInfo}"
                        VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">

                                <!--  普通行  -->
                                <Setter Property="Background" Value="{DynamicResource DataGridRowBackgroundBrush}" />

                                <Style.Triggers>
                                    <!--  交替行  -->
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource DataGridAlternatingRowBackgroundBrush}" />
                                    </Trigger>

                                    <!--  悬停：写在交替行 Trigger 之后，就会覆盖它  -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22000000" />
                                    </Trigger>

                                    <!--  选中：优先级最高  -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#44000000" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding EquipTypeName}"
                                CanUserSort="False"
                                Header="部位"
                                IsReadOnly="True" />

                            <!--  装备列  -->
                            <DataGridTemplateColumn
                                Width="*"
                                Header="装备"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding EquipIdName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  装饰珠孔位 1  -->
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="孔1"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Decoration1Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  装饰珠孔位 2  -->
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="孔2"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Decoration2Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  装饰珠孔位 3  -->
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="孔3"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Decoration3Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</Page>
