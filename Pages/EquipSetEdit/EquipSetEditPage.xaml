<Page
    x:Class="MH3GHDSaveEditor.Pages.EquipSetEdit.EquipSetEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MH3GHDSaveEditor.Pages.EquipSetEdit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="EquipSetEditRoot"
    Title="EquipSetEditPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="EquipSetEditPage_Loaded"
    mc:Ignorable="d">

    <Grid>
        <!--  直接放在任意 Grid 或 GroupBox 中  -->
        <GroupBox Margin="10" Header="套装列表">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <DataGrid
                    x:Name="EquipSetNameDataGrid"
                    AlternatingRowBackground="AliceBlue"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="True"
                    CanUserDeleteRows="True"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    SelectionChanged="EquipSetNameDataGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" Header="套装名称">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding EquipSetName}"
                                        ToolTip="双击编辑" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox VerticalAlignment="Center" Text="{Binding EquipSetName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>
                <Grid Grid.Column="1">
                    <DataGrid
                        x:Name="EquipSlotsDataGrid"
                        AlternatingRowBackground="AliceBlue"
                        AlternationCount="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="All"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding ElementName=EquipSetEditRoot, Path=equipSetSlotInfo}">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding EquipTypeName}"
                                CanUserSort="False"
                                Header="部位"
                                IsReadOnly="True" />

                            <!--  装备列  -->
                            <DataGridTemplateColumn
                                Width="*"
                                Header="装备"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding EquipIdName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  装饰珠孔位 1  -->
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="孔1"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Decoration1Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  装饰珠孔位 2  -->
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="孔2"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Decoration2Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  装饰珠孔位 3  -->
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="孔3"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Decoration3Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</Page>
